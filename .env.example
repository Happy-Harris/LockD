# Postgres. Unset = embedded PGLite (fine for local / guest).
DATABASE_URL=postgres://user:pass@host/dbname

# Better Auth. Required for real sign-in outside Grok preview.
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080

# Grok App Builder only — the preview federates Google/X through this broker.
# Outside Grok, rewire src/lib/auth to normal Google / X OAuth apps instead.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_PROJECT_ID=

# Optional. Server Lab (Ask the Lab) when you want model calls.
# XAI_API_KEY=
