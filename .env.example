# Every variable here is optional. With none set, Lock'd runs as a guest app: the log lives on the
# device and nothing asks anyone to sign in.

# Postgres for accounts, the cloud locker and public links. Unset = embedded PGLite (local only).
# DATABASE_URL=postgres://user:pass@host/dbname

# Sign-in. Needs the secret plus at least one method below; each method is on only when all of its
# variables are set.
# BETTER_AUTH_SECRET=generate-a-long-random-string
# BETTER_AUTH_URL=https://your-domain.example

# Google: an OAuth client (Web application) with the redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple: a Services ID with Sign in with Apple, return URL <BETTER_AUTH_URL>/api/auth/callback/apple,
# and a client secret (a JWT signed with your Apple key; it expires after at most 6 months).
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=

# Email: a one-tap sign-in link, sent through Resend from a verified sender.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Lockd <signin@your-domain.example>

# Optional. Server Lab (Ask the Lab) when you want model calls.
# XAI_API_KEY=
# Optional. Crash reporting (Sentry): the error and the page path only, never the log, email, IP or share links.
# Set at build time; with it unset no reporting code is downloaded. Its host is added to the content policy.
# VITE_SENTRY_DSN=
